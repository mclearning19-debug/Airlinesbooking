# Neon connection string: Neon console -> your project -> Connect.
# Use the pooled connection string (host contains "-pooler").
# Keep the real value ONLY in .env (gitignored). Never paste it into notes, docs or commits.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PORT=3000

# Better Auth. The secret signs sessions: generate one per environment, keep it only in .env / host secrets.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of this app (no trailing slash). Required in production, e.g. https://my-app.onrender.com
BETTER_AUTH_URL=http://localhost:3000
